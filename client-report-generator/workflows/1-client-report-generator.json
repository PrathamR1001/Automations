      "credentials": { "httpQueryAuth": { "id": "REPLACE_ME_PAGESPEED_CRED_ID", "name": "PageSpeed Query Auth account" } }
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst lh = resp.lighthouseResult || {};\nconst perf = lh.categories && lh.categories.performance;\nconst scoreRaw = perf ? perf.score : null;\nconst performanceScore = (scoreRaw !== null && scoreRaw !== undefined) ? Math.round(scoreRaw * 100) : null;\nconst url = lh.requestedUrl || resp.id || null;\nreturn [{ json: { performanceScore: performanceScore, url: url } }];\n"
      },
      "id": "27abfd62-2767-49c9-9391-6ea823d282ed",
      "name": "Extract Performance Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2208, 560]
    },
    {
      "parameters": {
        "jsCode": "const merged = $input.first().json;\nconst ctx = $('Determine Duplicate Status').item.json;\nconst rows = merged.rows || [];\nconst requiredCols = ['Website Sessions', 'Leads Generated', 'Conversion Rate (%)', 'Ad Spend (USD)', 'Revenue Attributed (USD)', 'New Backlinks'];\n\nconst currentPeriodRows = rows.filter((r) => r.Period === ctx.periodLabel);\nconst previousPeriodRows = rows.filter((r) => r.Period === ctx.previousPeriodLabel);\nconst currentRow = currentPeriodRows[0];\nconst previousRow = previousPeriodRows[0];\n\nlet isValid = true;\nlet validationError = '';\n\nif (currentPeriodRows.length > 1) {\n  isValid = false;\n  validationError = 'Found ' + currentPeriodRows.length + ' rows for period ' + ctx.periodLabel + ' for client ' + ctx.clientName + ' — ambiguous, expected exactly one.';\n} else if (previousPeriodRows.length > 1) {\n  isValid = false;\n  validationError = 'Found ' + previousPeriodRows.length + ' rows for the prior period ' + ctx.previousPeriodLabel + ' for client ' + ctx.clientName + ' — ambiguous, expected exactly one.';\n} else if (!currentRow) {\n  isValid = false;\n  validationError = 'No metrics row found for the current period (' + ctx.periodLabel + ') — the most recent complete calendar month — for client ' + ctx.clientName + '. The sheet may not have been updated yet.';\n} else if (!previousRow) {\n  isValid = false;\n  validationError = 'No metrics row found for the prior period (' + ctx.previousPeriodLabel + ') for client ' + ctx.clientName + '.';\n} else {\n  for (const col of requiredCols) {\n    const curVal = currentRow[col];\n    const prevVal = previousRow[col];\n    if (curVal === undefined || curVal === null || curVal === '' || isNaN(Number(curVal))) {\n      isValid = false;\n      validationError = 'Missing or non-numeric value for \"' + col + '\" in the current period row.';\n      break;\n    }\n    if (prevVal === undefined || prevVal === null || prevVal === '' || isNaN(Number(prevVal))) {\n      isValid = false;\n      validationError = 'Missing or non-numeric value for \"' + col + '\" in the prior period row.';\n      break;\n    }\n  }\n}\n\nif (isValid && (merged.performanceScore === null || merged.performanceScore === undefined)) {\n  isValid = false;\n  validationError = 'PageSpeed Insights did not return a performance score for ' + merged.url + '.';\n}\n\nreturn [{\n  json: {\n    clientName: ctx.clientName,\n    periodLabel: ctx.periodLabel,\n    previousPeriodLabel: ctx.previousPeriodLabel,\n    runId: ctx.runId,\n    thresholdPct: ctx.thresholdPct,\n    startedAt: ctx.startedAt,\n    currentRow: currentRow || {},\n    previousRow: previousRow || {},\n    externalMetric: { performanceScore: merged.performanceScore, url: merged.url },\n    isValid: isValid,\n    validationError: validationError,\n  },\n}];\n"
      },
      "id": "1b32d4aa-255c-4475-9157-a28fc4d86c82",
      "name": "Validate Source Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2768, 432]
    },
