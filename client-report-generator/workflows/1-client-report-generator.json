      "parameters": {
        "conditions": { "combinator": "and", "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 }, "conditions": [ { "leftValue": "={{ $json.isValid }}", "operator": { "type": "boolean", "operation": "equals" }, "rightValue": true } ] },
        "options": {}
      },
      "id": "ad6f2d99-c402-4084-8c4f-134e593c95e1",
      "name": "Source Data Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [3040, 432]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst metricCols = ['Website Sessions', 'Leads Generated', 'Conversion Rate (%)', 'Ad Spend (USD)', 'Revenue Attributed (USD)', 'New Backlinks'];\nconst cur = item.currentRow;\nconst prev = item.previousRow;\nconst thresholdPct = item.thresholdPct;\n\nconst metrics = metricCols.map((col) => {\n  const currentValue = Number(cur[col]);\n  const previousValue = Number(prev[col]);\n  const delta = currentValue - previousValue;\n  const pctChange = previousValue !== 0 ? (delta / Math.abs(previousValue)) * 100 : (currentValue !== 0 ? 100 : 0);\n  const flagged = Math.abs(pctChange) > thresholdPct;\n  return { name: col, currentValue: currentValue, previousValue: previousValue, delta: delta, pctChange: pctChange, flagged: flagged };\n});\n\nreturn [{\n  json: {\n    clientName: item.clientName,\n    period: item.periodLabel,\n    thresholdPct: thresholdPct,\n    runId: item.runId,\n    startedAt: item.startedAt,\n    metrics: metrics,\n    externalMetric: item.externalMetric,\n  },\n}];\n"
      },
      "id": "ca2e3258-b48e-4d9c-b362-a063694a7143",
      "name": "Compute Deltas & Flag Changes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3328, 560]
    },
    {
      "parameters": {
        "modelId": { "__rl": true, "mode": "id", "value": "models/gemini-3.6-flash", "cachedResultName": "models/gemini-3.6-flash" },
        "messages": { "values": [ { "content": "=Client: {{ $json.clientName }}\nReporting period: {{ $json.period }}\nThreshold for a notable change: {{ $json.thresholdPct }}%\n\nMetrics (JSON): {{ JSON.stringify($json.metrics) }}\nExternal metric (site performance): {{ JSON.stringify($json.externalMetric) }}\n\nWrite the executive summary and notable changes now, following the schema exactly." } ] },
        "jsonOutput": true,
        "builtInTools": { "googleSearch": false, "urlContext": false, "codeExecution": false },
        "options": {
          "includeMergedResponse": true,
          "systemMessage": "You are a data analyst writing an executive summary for a monthly client performance report. You will be given a JSON object containing this period's metrics, the prior period's metrics, computed deltas and percentage changes, and a flag for any metric that moved more than the configured threshold. Base your summary strictly on the numbers provided — do not invent causes, external events, or context that isn't in the data. If the cause of a change cannot be determined from the data, say so only ONCE — as a single closing sentence in the executive summary — rather than repeating that disclaimer after every metric. Individual notable_changes comments must describe what changed and by how much, in plain, varied language, WITHOUT repeating the 'not determinable from the available data' disclaimer in each one — that caveat belongs once, in the executive summary only. Respond with ONLY valid JSON matching this schema, no markdown fences, no commentary: {\"executive_summary\": string, \"notable_changes\": [{\"metric\": string, \"direction\": \"up\"|\"down\", \"change_pct\": number, \"comment\": string}], \"overall_sentiment\": \"positive\"|\"neutral\"|\"mixed\"|\"negative\"}",
          "maxOutputTokens": 6000,
          "temperature": 0.3,
          "thinkingBudget": -1
        }
      },
      "id": "572ee7f5-da59-446f-a674-4ecfd3c2bbb1",
      "name": "Generate Executive Summary (Gemini)",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [3600, 560],
      "credentials": { "googlePalmApi": { "id": "REPLACE_ME_GEMINI_CRED_ID", "name": "Google Gemini (PaLM) Api account" } }
    },
    {
      "parameters": {
        "jsCode": "const raw0 = $input.first().json;\nconst rawText = raw0.mergedResponse ?? raw0.content ?? raw0.text ?? raw0.output ?? raw0.message ?? raw0.data ?? (typeof raw0 === 'string' ? raw0 : JSON.stringify(raw0));\nconst ctx = $('Compute Deltas & Flag Changes').item.json;\n\nlet parsed = null;\nlet parseOk = true;\nlet parseError = '';\n\nconst extractJson = (text) => {\n  let cleaned = String(text).trim();\n  const fenceMatch = cleaned.match(/```(?:json)?\\s*([\\s\\S]*?)\\s*```/i);\n  if (fenceMatch) {\n    cleaned = fenceMatch[1].trim();\n  }\n  return cleaned;\n};\n\ntry {\n  const cleaned = extractJson(rawText);\n  parsed = JSON.parse(cleaned);\n  if (!parsed.executive_summary || !Array.isArray(parsed.notable_changes) || !parsed.overall_sentiment) {\n    parseOk = false;\n    parseError = 'AI response JSON is missing required fields (executive_summary, notable_changes, overall_sentiment).';\n  }\n} catch (e) {\n  parseOk = false;\n  parseError = 'Failed to parse AI response as JSON: ' + e.message;\n}\n\nreturn [{\n  json: {\n    clientName: ctx.clientName,\n    period: ctx.period,\n    thresholdPct: ctx.thresholdPct,\n    runId: ctx.runId,\n    startedAt: ctx.startedAt,\n    metrics: ctx.metrics,\n    externalMetric: ctx.externalMetric,\n    executiveSummary: parseOk ? parsed.executive_summary : '',\n    notableChanges: parseOk ? parsed.notable_changes : [],\n    overallSentiment: parseOk ? parsed.overall_sentiment : '',\n    isValid: parseOk,\n    validationError: parseError,\n  },\n}];\n"
      },
