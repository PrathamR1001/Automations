{
  "name": "QTD - Signature Callback Receiver",
  "nodes": [
    {
      "id": "aa1a2b3c-4d5e-6f70-8192-a3b4c5d6e7f8",
      "name": "Signature Callback Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [240, 300],
      "parameters": { "httpMethod": "POST", "path": "quote-signed-callback", "authentication": "none", "responseMode": "onReceived", "options": {} }
    },
    {
      "id": "bb2b3c4d-5e6f-7081-92a3-b4c5d6e7f8a9",
      "name": "Normalize Signature Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [540, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body || {};\nconst enquiryId = body.enquiryId || raw.enquiryId || '';\nconst signedAt = body.signedAt || raw.signedAt || new Date().toISOString();\nreturn [{ json: { enquiryId: enquiryId, signedAt: signedAt } }];\n"
      }
    },
    {
      "id": "cc3c4d5e-6f70-8192-a3b4-c5d6e7f8a9b0",
      "name": "Find Quote Record",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [840, 300],
      "parameters": {
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "mode": "id", "value": "YOUR_AIRTABLE_BASE_ID", "cachedResultName": "Quote Pipeline" },
        "table": { "__rl": true, "mode": "id", "value": "YOUR_AIRTABLE_TABLE_ID", "cachedResultName": "Quotes" },
        "filterByFormula": "={{ \"{EnquiryId} = '\" + $json.enquiryId + \"'\" }}",
        "returnAll": true,
        "options": {}
      },
      "alwaysOutputData": true,
      "credentials": { "airtableTokenApi": { "id": "REPLACE_ME_AIRTABLE_CRED_ID", "name": "Airtable Personal Access Token account" } }
    },
    {
      "id": "dd4d5e6f-7081-92a3-b4c5-d6e7f8a9b0c1",
      "name": "Determine Record Found",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const found = $input.all();\nconst first = found.length > 0 ? found[0].json : {};\nconst recordFound = !!(first && first.id !== undefined && first.id !== null);\nconst ctx = $('Normalize Signature Payload').item.json;\nreturn [{\n  json: {\n    enquiryId: ctx.enquiryId,\n    signedAt: ctx.signedAt,\n    recordFound: recordFound,\n  },\n}];\n"
      }
    },
    {
      "id": "ee5e6f70-8192-a3b4-c5d6-e7f8a9b0c1d2",
      "name": "Record Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1440, 300],
      "parameters": { "conditions": { "combinator": "and", "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 }, "conditions": [ { "leftValue": "={{ $json.recordFound }}", "operator": { "type": "boolean", "operation": "equals" }, "rightValue": true } ] } }
    },
    {
      "id": "ff6f7081-92a3-b4c5-d6e7-f8a9b0c1d2e3",
      "name": "Update Quote Record",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [1740, 200],
      "parameters": {
        "resource": "record",
        "operation": "update",
        "base": { "__rl": true, "mode": "id", "value": "YOUR_AIRTABLE_BASE_ID", "cachedResultName": "Quote Pipeline" },
        "table": { "__rl": true, "mode": "id", "value": "YOUR_AIRTABLE_TABLE_ID", "cachedResultName": "Quotes" },
        "columns": { "mappingMode": "defineBelow", "matchingColumns": ["EnquiryId"], "value": { "EnquiryId": "={{ $json.enquiryId }}", "Status": "signed", "SignedAt": "={{ $json.signedAt }}" } },
        "options": { "typecast": true }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": { "airtableTokenApi": { "id": "REPLACE_ME_AIRTABLE_CRED_ID", "name": "Airtable Personal Access Token account" } }
    },
    {
      "id": "007081a2-b3c4-d5e6-f7a8-b9c0d1e2f3a4",
      "name": "Log Signed Event",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [2040, 200],
      "parameters": {
        "workflowId": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_LOG_RUN_WORKFLOW_ID", "cachedResultName": "QTD - Log Run" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true,
          "value": { "runId": "={{ $execution.id }}-signed", "prospectName": "={{ $('Determine Record Found').item.json.enquiryId }}", "quoteTotal": 0, "status": "signed", "durationMs": 0, "error": "" },
          "schema": [
            { "id": "runId", "displayName": "runId", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "prospectName", "displayName": "prospectName", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "quoteTotal", "displayName": "quoteTotal", "type": "number", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "status", "displayName": "status", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "durationMs", "displayName": "durationMs", "type": "number", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "error", "displayName": "error", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true }
          ]
        }
      }
    },
    { "id": "118192a3-b4c5-d6e7-f8a9-b0c1d2e3f4a5", "name": "Fail - Unknown Enquiry ID", "type": "n8n-nodes-base.stopAndError", "typeVersion": 1, "position": [1740, 420], "parameters": { "errorType": "errorMessage", "errorMessage": "=No quote record found for enquiryId \"{{ $json.enquiryId }}\" — cannot mark as signed." } },
    { "id": "229293a4-c5d6-e7f8-a9b0-c1d2e3f4a5b6", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [190, 250], "parameters": { "content": "## QTD - Signature Callback Receiver\nPLACEHOLDER endpoint — point your e-sign provider's webhook/callback configuration at this URL once connected. This assumes an illustrative {enquiryId, signedAt} payload shape, not a real provider's schema — adjust Normalize Signature Payload's field mapping to match whichever provider (DocuSign / Dropbox Sign) you actually connect.\n\nRuns as its own workflow, independent of the main pipeline's execution, because a signature can arrive minutes or days later from an external system on its own schedule.", "color": 5, "width": 900, "height": 200 } }
  ],
  "connections": {
    "Signature Callback Webhook": { "main": [ [ { "node": "Normalize Signature Payload", "type": "main", "index": 0 } ] ] },
    "Normalize Signature Payload": { "main": [ [ { "node": "Find Quote Record", "type": "main", "index": 0 } ] ] },
    "Find Quote Record": { "main": [ [ { "node": "Determine Record Found", "type": "main", "index": 0 } ] ] },
    "Determine Record Found": { "main": [ [ { "node": "Record Found?", "type": "main", "index": 0 } ] ] },
    "Record Found?": { "main": [ [ { "node": "Update Quote Record", "type": "main", "index": 0 } ], [ { "node": "Fail - Unknown Enquiry ID", "type": "main", "index": 0 } ] ] },
    "Update Quote Record": { "main": [ [ { "node": "Log Signed Event", "type": "main", "index": 0 } ] ] }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "REPLACE_WITH_ERROR_ALERT_WORKFLOW_ID"
  },
  "pinData": {}
}
