      "position": [1280, 200],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const existing = $input.all();\nconst first = existing.length > 0 ? existing[0].json : {};\nconst quoteExists = !!(first && first.id !== undefined && first.id !== null);\nconst ctx = $('Normalize & Validate Input').item.json;\nreturn [{\n  json: {\n    enquiryId: ctx.enquiryId,\n    name: ctx.name,\n    email: ctx.email,\n    phone: ctx.phone,\n    propertyAddress: ctx.propertyAddress,\n    propertySizeSqFt: ctx.propertySizeSqFt,\n    requirementsText: ctx.requirementsText,\n    runId: ctx.runId,\n    startedAt: ctx.startedAt,\n    quoteExists: quoteExists,\n  },\n}];\n"
