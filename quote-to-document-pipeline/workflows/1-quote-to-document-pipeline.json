    {
      "id": "7949a753-3280-4237-a668-93ffdc8e77a8",
      "name": "Compute Quote Pricing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2480, 240],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst cfg = $('Config').first().json;\nconst rates = JSON.parse(cfg.pricingRatesJson);\nconst sizeTierThresholdSqFt = cfg.sizeTierThresholdSqFt;\nconst sizeTierMultiplier = cfg.sizeTierMultiplier;\nconst discountThresholdTotal = cfg.discountThresholdTotal;\nconst discountPct = cfg.discountPct;\nconst isLargeProperty = item.propertySizeSqFt > sizeTierThresholdSqFt;\n\nconst lineItems = (item.lineItems || []).map((li) => {\n  const baseRate = rates[li.category] !== undefined ? rates[li.category] : rates.other;\n  const unitRate = isLargeProperty ? Math.round(baseRate * sizeTierMultiplier * 100) / 100 : baseRate;\n  const lineTotal = Math.round(unitRate * li.quantity * 100) / 100;\n  return { description: li.description, category: li.category, quantity: li.quantity, unit: li.unit, unitRate: unitRate, lineTotal: lineTotal };\n});\n\nconst subtotal = Math.round(lineItems.reduce((sum, li) => sum + li.lineTotal, 0) * 100) / 100;\nconst discountApplies = subtotal > discountThresholdTotal;\nconst discountAmount = discountApplies ? Math.round(subtotal * (discountPct / 100) * 100) / 100 : 0;\nconst grandTotal = Math.round((subtotal - discountAmount) * 100) / 100;\n\nreturn [{\n  json: {\n    enquiryId: item.enquiryId,\n    name: item.name,\n    email: item.email,\n    phone: item.phone,\n    propertyAddress: item.propertyAddress,\n    propertySizeSqFt: item.propertySizeSqFt,\n    runId: item.runId,\n    startedAt: item.startedAt,\n    scopeSummary: item.scopeSummary,\n    clarifyingAssumptions: item.clarifyingAssumptions,\n    lineItems: lineItems,\n    totals: { subtotal: subtotal, discountPct: discountApplies ? discountPct : 0, discountAmount: discountAmount, grandTotal: grandTotal },\n  },\n}];\n"
      }
    },
