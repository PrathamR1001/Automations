    {
      "id": "2a765e64-dc24-444c-96ff-0bf9de9f3500",
      "name": "Create Quote Record in Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [3280, 120],
      "parameters": {
