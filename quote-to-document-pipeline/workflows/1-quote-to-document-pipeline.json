    {
      "id": "97f2b8a7-9106-4a74-8351-7e841a721502",
      "name": "Normalize & Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 280],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body || {};\nconst enquiryId = body.enquiryId || raw.enquiryId || '';\nconst name = body.name || raw.name || '';\nconst email = body.email || raw.email || '';\nconst phone = body.phone || raw.phone || '';\nconst propertyAddress = body.propertyAddress || raw.propertyAddress || '';\nconst propertySizeSqFtRaw = body.propertySizeSqFt !== undefined ? body.propertySizeSqFt : raw.propertySizeSqFt;\nconst requirementsText = body.requirementsText || raw.requirementsText || '';\n\nlet isValid = true;\nlet validationError = '';\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nif (!enquiryId) {\n  isValid = false;\n  validationError = 'Missing required field: enquiryId.';\n} else if (!name) {\n  isValid = false;\n  validationError = 'Missing required field: name.';\n} else if (!email || !emailRegex.test(email)) {\n  isValid = false;\n  validationError = 'Missing or malformed field: email.';\n} else if (propertySizeSqFtRaw === undefined || propertySizeSqFtRaw === null || propertySizeSqFtRaw === '' || isNaN(Number(propertySizeSqFtRaw)) || Number(propertySizeSqFtRaw) <= 0) {\n  isValid = false;\n  validationError = 'Missing or non-numeric field: propertySizeSqFt.';\n} else if (!requirementsText) {\n  isValid = false;\n  validationError = 'Missing required field: requirementsText.';\n}\n\nreturn [{\n  json: {\n    enquiryId: enquiryId,\n    name: name,\n    email: email,\n    phone: phone,\n    propertyAddress: propertyAddress,\n    propertySizeSqFt: Number(propertySizeSqFtRaw),\n    requirementsText: requirementsText,\n    runId: $execution.id,\n    startedAt: $now.toISO(),\n    isValid: isValid,\n    validationError: validationError,\n  },\n}];\n"
      }
    },
