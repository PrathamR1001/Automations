        "operation": "create",
        "base": { "__rl": true, "mode": "id", "value": "YOUR_AIRTABLE_BASE_ID", "cachedResultName": "Quote Pipeline" },
        "table": { "__rl": true, "mode": "id", "value": "YOUR_AIRTABLE_TABLE_ID", "cachedResultName": "Quotes" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "EnquiryId": "={{ $('Compute Quote Pricing').item.json.enquiryId }}",
            "ProspectName": "={{ $('Compute Quote Pricing').item.json.name }}",
            "Email": "={{ $('Compute Quote Pricing').item.json.email }}",
            "Phone": "={{ $('Compute Quote Pricing').item.json.phone }}",
            "PropertyAddress": "={{ $('Compute Quote Pricing').item.json.propertyAddress }}",
            "PropertySizeSqFt": "={{ $('Compute Quote Pricing').item.json.propertySizeSqFt }}",
            "RequirementsText": "={{ $('Normalize & Validate Input').item.json.requirementsText }}",
