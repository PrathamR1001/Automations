    {
      "id": "9dfdde20-67f2-4733-905f-8a76e93c4d83",
      "name": "Generate Quote Content (Gemini)",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [1760, 360],
      "parameters": {
        "modelId": { "__rl": true, "mode": "id", "value": "models/gemini-3.6-flash", "cachedResultName": "models/gemini-3.6-flash" },
        "messages": { "values": [ { "content": "=Property size: {{ $json.propertySizeSqFt }} sq ft.\nProspect requirements: {{ $json.requirementsText }}.\n\nGenerate the quote line items and scope now." } ] },
        "jsonOutput": true,
        "builtInTools": { "googleSearch": false, "urlContext": false, "codeExecution": false },
        "options": {
          "includeMergedResponse": true,
          "systemMessage": "You are a quoting assistant for a home services company performing solar panel installations. You will be given a prospect's free-text description of what they want, along with their property size. Break this down into a structured list of line items a quote would contain. Base every line item ONLY on what the prospect actually described, or on standard requirements directly implied by the job type (e.g., a panel installation always needs mounting hardware and an inverter) - do not invent scope, brands, or requirements beyond what's reasonably implied. Each line item's category must be exactly one of: panels, inverter, mounting, electrical, permit, labor, other - this is used to look up pricing, so do not invent new category names. When you must assume something not explicitly stated in order to produce a line item (e.g., roof type, panel count, electrical panel capacity), list that assumption separately under clarifying_assumptions rather than silently building it into a line item description. Respond with ONLY valid JSON matching this schema, no markdown fences, no commentary: {\"scope_summary\": string, \"line_items\": [{\"description\": string, \"category\": \"panels\"|\"inverter\"|\"mounting\"|\"electrical\"|\"permit\"|\"labor\"|\"other\", \"quantity\": number, \"unit\": string}], \"clarifying_assumptions\": [string]}",
          "maxOutputTokens": 6000,
          "temperature": 0.3,
          "thinkingBudget": -1
        }
      },
      "credentials": { "googlePalmApi": { "id": "REPLACE_ME_GEMINI_CRED_ID", "name": "Google Gemini(PaLM) Api account" } }
    },
    {
      "id": "7b4bfd87-2695-4efa-a6cd-74906f55ff0a",
      "name": "Parse & Validate AI JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 360],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw0 = $input.first().json;\nconst rawText = raw0.mergedResponse ?? raw0.content ?? raw0.text ?? raw0.output ?? raw0.message ?? raw0.data ?? (typeof raw0 === 'string' ? raw0 : JSON.stringify(raw0));\nconst ctx = $('Determine Duplicate Status').item.json;\nconst allowedCategories = ['panels', 'inverter', 'mounting', 'electrical', 'permit', 'labor', 'other'];\n\nlet parsed = null;\nlet parseOk = true;\nlet parseError = '';\n\nconst extractJson = (text) => {\n  let cleaned = String(text).trim();\n  const fenceMatch = cleaned.match(/```(?:json)?\\s*([\\s\\S]*?)\\s*```/i);\n  if (fenceMatch) {\n    cleaned = fenceMatch[1].trim();\n  }\n  return cleaned;\n};\n\ntry {\n  const cleaned = extractJson(rawText);\n  parsed = JSON.parse(cleaned);\n  if (!parsed.scope_summary || !Array.isArray(parsed.line_items) || !Array.isArray(parsed.clarifying_assumptions)) {\n    parseOk = false;\n    parseError = 'AI response JSON is missing required fields (scope_summary, line_items, clarifying_assumptions).';\n  } else {\n    for (const li of parsed.line_items) {\n      if (allowedCategories.indexOf(li.category) === -1) {\n        parseOk = false;\n        parseError = 'AI returned an invalid line item category \"' + li.category + '\" — expected one of: ' + allowedCategories.join(', ') + '.';\n        break;\n      }\n    }\n  }\n} catch (e) {\n  parseOk = false;\n  parseError = 'Failed to parse AI response as JSON: ' + e.message;\n}\n\nreturn [{\n  json: {\n    enquiryId: ctx.enquiryId,\n    name: ctx.name,\n    email: ctx.email,\n    phone: ctx.phone,\n    propertyAddress: ctx.propertyAddress,\n    propertySizeSqFt: ctx.propertySizeSqFt,\n    runId: ctx.runId,\n    startedAt: ctx.startedAt,\n    scopeSummary: parseOk ? parsed.scope_summary : '',\n    lineItems: parseOk ? parsed.line_items : [],\n    clarifyingAssumptions: parseOk ? parsed.clarifying_assumptions : [],\n    isValid: parseOk,\n    validationError: parseError,\n  },\n}];\n"
      }
    },
    {
      "id": "3f8ce05e-97f5-4a51-a84f-b9570fb19cdf",
      "name": "AI Output Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [2240, 360],
      "parameters": { "conditions": { "combinator": "and", "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 }, "conditions": [ { "leftValue": "={{ $json.isValid }}", "operator": { "type": "boolean", "operation": "equals" }, "rightValue": true } ] } }
